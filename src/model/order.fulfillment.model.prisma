model OrderFulfillments {
  date_created         DateTime           @default(now()) @db.Timestamp(0)
  fulfillment_id       BigInt             @id @default(autoincrement())
  order_id             Int
  notes                String?            @db.TinyText
  fulfillment_date     DateTime           @db.DateTime(0)
  expected_return_date DateTime?          @db.DateTime(0)
  fulfillment_status   fulfillment_status @default(due)
  last_update_by       String?            @db.VarChar(255)
  last_update_to       String?            @db.VarChar(255)
  last_update_at       DateTime?          @db.DateTime(0)
  kz_fulfillment_items FulfillmentItems[]
  kz_subscriber_orders SubscriberOrders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, map: "fk_of_subscriber_id")

  @@index([order_id], map: "fk_of_subscriber_id")
  @@map("kz_order_fulfillments")
}

enum fulfillment_status {
  due
  fulfilled
  delivered
  returned
}
